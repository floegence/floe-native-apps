+/* Describe the original session-bus caller of an underlying IBus context.
+ * This does not forward input, change grants, or expose document contents. */
+static void
+floe_describe_source (GDBusConnection *connection, const gchar *sender,
+                      const gchar *path, const gchar *interface_name,
+                      const gchar *method_name, GVariant *parameters,
+                      GDBusMethodInvocation *invocation, gpointer data)
+{
+    (void) connection; (void) sender; (void) path; (void) interface_name;
+    (void) method_name; (void) data;
+    const gchar *source_path = NULL;
+    g_variant_get (parameters, "(&o)", &source_path);
+    GList *item;
+    for (item = all_contexts; item; item = item->next) {
+        IBusPortalContext *context = item->data;
+        if (g_strcmp0 (source_path, g_dbus_proxy_get_object_path (G_DBUS_PROXY (context->context))) == 0) {
+            g_dbus_method_invocation_return_value (invocation,
+                g_variant_new ("(uso)", 1u, context->owner, context->object_path));
+            return;
+        }
+    }
+    g_dbus_method_invocation_return_dbus_error (invocation,
+        "org.floegence.IBus.ContextSource.Unavailable", "INPUT_CONTEXT_UNAVAILABLE");
+}
+
+static const gchar floe_source_xml[] =
+    "<node><interface name='org.floegence.IBus.ContextSource'><method name='Describe'>"
+    "<arg direction='in' type='o' name='source_context'/>"
+    "<arg direction='out' type='u' name='version'/>"
+    "<arg direction='out' type='s' name='owner'/>"
+    "<arg direction='out' type='o' name='portal_context'/>"
+    "</method></interface></node>";
+
+static const GDBusInterfaceVTable floe_source_vtable = {
+    .method_call = floe_describe_source,
+};
+
