+/* No input text or document context is exposed by this description. The
+ * connection is the actual owner retained by IBus, not a client description. */
+GVariant *
+bus_input_context_describe_source (BusInputContext *context)
+{
+    if (!context->connection || context->fake)
+        return NULL;
+    GDBusConnection *connection =
+        bus_connection_get_dbus_connection (context->connection);
+    const gchar *owner = bus_connection_get_unique_name (context->connection);
+    GCredentials *credentials = g_dbus_connection_get_peer_credentials (connection);
+    if (!owner || !credentials || g_dbus_connection_is_closed (connection))
+        return NULL;
+    GError *error = NULL;
+    pid_t pid = g_credentials_get_unix_pid (credentials, &error);
+    if (error) { g_error_free (error); return NULL; }
+    uid_t uid = g_credentials_get_unix_user (credentials, &error);
+    if (error) { g_error_free (error); return NULL; }
+    if (pid <= 1)
+        return NULL;
+    return g_variant_new ("(usuubb)", 1u, owner, (guint) pid, (guint) uid,
+                          context->has_focus, context->use_post_process_key_event);
+}
