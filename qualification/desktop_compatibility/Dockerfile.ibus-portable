# Disposable native compiler. Applications never inherit this image or its tools.
FROM public.ecr.aws/docker/library/alpine@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
# Retain the signed archive closure with its hashes so the resulting builder
# digest and source build record identify the actual dependency snapshot.
RUN mkdir /builder-apks && apk update && apk fetch --recursive --output /builder-apks \
    build-base glib-dev dbus-dev gettext-dev intltool libtool python3 && \
    apk verify /builder-apks/*.apk && apk add --no-network /builder-apks/*.apk && \
    sha256sum /builder-apks/*.apk > /builder-apks.sha256
RUN apk fetch --recursive --output /builder-apks iso-codes-dev libx11-dev && \
    apk verify /builder-apks/*.apk && apk add --no-network /builder-apks/*.apk && \
    sha256sum /builder-apks/*.apk > /builder-apks.sha256
